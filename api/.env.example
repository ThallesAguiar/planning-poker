# Usado para rodar a API fora do Docker (npm run start:dev).
# Hosts apontam para as portas expostas dos containers no host.
DATABASE_URL=postgresql://planning:planning@localhost:5432/planning_poker?schema=public
REDIS_URL=redis://localhost:6380
JWT_SECRET=replace-with-a-development-secret
PORT=3000
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_MS=10000
LLM_MAX_REQUESTS_PER_ROUND=1
