# Usado pelo `docker compose` (env_file e interpolacao no docker-compose.yml).
# Hosts apontam para os nomes de servico da rede Docker, nao para localhost.
DATABASE_URL=postgresql://planning:planning@postgres:5432/planning_poker?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-a-development-secret
ACCOUNT_SESSION_TTL=12h
PORT=3000
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_MS=10000
LLM_MAX_REQUESTS_PER_ROUND=1

# Usado como build arg do frontend containerizado; API nao le esta variavel.
VITE_API_URL=http://localhost:3333
